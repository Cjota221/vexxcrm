# ============================================================
# VEXX CRM 2.0 - Environment Variables Template
# ============================================================
# Copie este arquivo para .env.local e preencha com suas credenciais
# NUNCA commite o arquivo .env.local no Git!
# ============================================================

# ============================================================
# SUPABASE
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# OPENAI (Anne IA)
# ============================================================
OPENAI_API_KEY=sk-proj-...

# ============================================================
# EVOLUTION API (WhatsApp) — SaaS Multi-Tenant
# ============================================================
# URL base da Evolution API na VPS (Hostinger)
EVOLUTION_API_URL=https://evolution.suavps.com

# Chave GLOBAL da Evolution API (protegida no servidor, NUNCA exposta ao client)
EVOLUTION_GLOBAL_KEY=sua-global-api-key

# Webhook secret para validar webhooks da Evolution
EVOLUTION_WEBHOOK_SECRET=sua-webhook-secret

# IPs permitidos para webhooks (separados por vírgula, opcional)
# EVOLUTION_ALLOWED_IPS=1.2.3.4,5.6.7.8

# ============================================================
# n8n (Inteligência Multimídia — Anne)
# ============================================================
# URL do webhook n8n para transbordo de mídia (áudio, imagem, vídeo)
# N8N_MEDIA_WEBHOOK_URL=https://n8n.suavps.com/webhook/media-process

# Secret para autenticar callbacks do n8n
# N8N_WEBHOOK_SECRET=seu-n8n-secret

# ============================================================
# FACILZAP (E-commerce)
# ============================================================
# Token de acesso da FacilZap
# Nota: Cada tenant pode ter seu próprio token no banco
FACILZAP_TOKEN=seu-token

# URL do site FacilZap
FACILZAP_SITE_URL=https://meusite.facilzap.app.br

# ============================================================
# NEXT.JS
# ============================================================
# URL do seu app em produção (para CORS, webhooks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# OPCIONAL - CACHE & PERFORMANCE
# ============================================================
# Vercel KV (Redis) - para cache distribuído
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...

# ============================================================
# OPCIONAL - MONITORING
# ============================================================
# Sentry
# SENTRY_DSN=...

# Vercel Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=...
