# ============================================================
# VEXX CRM 2.0 - Environment Variables Template
# ============================================================
# Copie este arquivo para .env.local e preencha com suas credenciais
# NUNCA commite o arquivo .env.local no Git!
# ============================================================

# ============================================================
# SUPABASE
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# OPENAI (Anne IA)
# ============================================================
OPENAI_API_KEY=sk-proj-...

# ============================================================
# EVOLUTION API (WhatsApp)
# ============================================================
# URL base da sua instância Evolution API
EVOLUTION_API_URL=https://api.evolution.com

# API Key global (se necessário)
# Nota: Cada tenant pode ter sua própria key no banco
EVOLUTION_API_KEY=sua-api-key

# ============================================================
# FACILZAP (E-commerce)
# ============================================================
# Token de acesso da FacilZap
# Nota: Cada tenant pode ter seu próprio token no banco
FACILZAP_TOKEN=seu-token

# URL do site FacilZap
FACILZAP_SITE_URL=https://meusite.facilzap.app.br

# ============================================================
# NEXT.JS
# ============================================================
# URL do seu app em produção (para CORS, webhooks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# OPCIONAL - CACHE & PERFORMANCE
# ============================================================
# Vercel KV (Redis) - para cache distribuído
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...

# ============================================================
# OPCIONAL - MONITORING
# ============================================================
# Sentry
# SENTRY_DSN=...

# Vercel Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=...
